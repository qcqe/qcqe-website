# 数据库配置
MYSQL_ROOT_PASSWORD=your_secure_root_password_123456
MYSQL_PASSWORD=your_secure_db_password_123456

# WordPress配置
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=false

# SSL配置
SSL_CERT_PATH=./nginx/ssl/fexlink.com.pem
SSL_KEY_PATH=./nginx/ssl/fexlink.com.key

# Redis配置
REDIS_PASSWORD=your_redis_password_123456

# 备份配置
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # 每天凌晨2点备份

# 开发环境配置
DEV_MYSQL_ROOT_PASSWORD=dev_root_password_123456
DEV_MYSQL_PASSWORD=dev_password_123456
DEV_REDIS_PASSWORD=dev_redis_password_123456

# 应用配置
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=your_app_secret_key_here

# 域名配置
PRIMARY_DOMAIN=www.fexlink.com
SECONDARY_DOMAIN=yeslon.com

# 时区配置
TIMEZONE=Asia/Shanghai

# 缓存配置
REDIS_CACHE_TTL=3600
REDIS_CACHE_MAX_SIZE=1000

# 日志配置
LOG_LEVEL=info
LOG_RETENTION_DAYS=30

# 安全配置
ALLOWED_HOSTS=www.fexlink.com,fexlink.com,kb.fexlink.com,cases.fexlink.com,docs.fexlink.com,standards.fexlink.com,lightning.fexlink.com,safety.fexlink.com,energy.fexlink.com,monitor.fexlink.com,saving.fexlink.com,carbon.fexlink.com,zerocarbon.fexlink.com,analysis.fexlink.com